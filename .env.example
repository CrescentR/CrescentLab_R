# 生产环境请改为实际域名；这两个值会在前台/后台构建时写入客户端资源。
ADMIN_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000

# 后端 TOML 配置文件路径（相对于项目根目录）。
# 生产环境建议复制 data/conf.ini.example 为 data/conf.ini 后填写密钥和数据库 DSN。
BACKEND_CONFIG=default_files/conf.postgres.ini

# 可选：替换基础镜像或 Node 包镜像源。
GO_IMAGE=m.daocloud.io/docker.io/library/golang:1.26-alpine
ALPINE_IMAGE=m.daocloud.io/docker.io/library/alpine:3.22
NODE_IMAGE=m.daocloud.io/docker.io/library/node:24-slim
POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:16-alpine
NPM_REGISTRY=https://registry.npmmirror.com
